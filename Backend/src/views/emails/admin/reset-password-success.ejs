<%- include("../../_partials/header", { title: `Password Reset Successful`, heading: "Your Password Has Been Reset" }) %>

<p style="margin: 0 0 12px;">Hello <strong><%= name %></strong>,</p>
<p style="margin: 0 0 12px;">
  Your admin account password has been successfully reset.
</p>

<div style="background-color: #f0f7f0; padding: 15px; border-radius: 6px; border-left: 4px solid #28a745; margin: 16px 0;">
  <p style="margin: 5px 0; color: #28a745;"><strong>&#10003; Password changed successfully</strong></p>
  <p style="margin: 5px 0; color: #555;">If you made this change, no further action is needed.</p>
</div>

<p style="margin: 0 0 16px;">You can now log in to the admin portal using your new password.</p>

<div style="text-align: center; margin: 24px 0;">
  <a
    href="<%= adminPortalUrl %>"
    style="background-color: #093981; color: #ffffff; padding: 12px 22px; text-decoration: none; border-radius: 6px; font-weight: bold; display: inline-block;"
  >
    Login to Admin Portal
  </a>
</div>

<p style="margin: 0; color: #666; font-size: 13px;">
  If you did <strong>not</strong> make this change, please contact support immediately as your account may be compromised.
</p>

<%- include("../../_partials/footer") %>
